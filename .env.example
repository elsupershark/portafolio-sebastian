# Copia este archivo a .env.local (o usa: vercel env pull .env.local).
# Los valores de abajo son FALSOS. Nunca subas .env ni .env.local a Git.

# Frase larga de acceso (minimo 12 caracteres; mejor 5 palabras o mas)
CHAT_SECRET=example-frase-larga-cambiala-por-la-tuya

# Cadena aleatoria para firmar la sesion (minimo 32 caracteres)
CHAT_SESSION_KEY=example-cambia-esto-por-48-bytes-aleatorios

# Minutos que dura un mensaje (por defecto 30)
CHAT_TTL_MIN=30

# Los inyecta la integracion de Upstash en Vercel (nombres posibles: UPSTASH_REDIS_REST_* o KV_REST_API_*)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=example-token
